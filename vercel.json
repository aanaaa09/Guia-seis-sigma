{
  "builds": [
    {
      "src": "scripts/build.py",
      "use": "@vercel/python",
      "config": {
        "zeroConfig": false
      }
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/css/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}